# Copy to .env and fill in. Never commit .env.

# Public base URL this app is reachable at. Instagram and Threads fetch media
# from ${PUBLIC_URL}/media/<id>, so it must be reachable from the internet.
# See docs/public-url.md (domain, Cloudflare Tunnel, or ngrok).
PUBLIC_URL=

# Where the SQLite file and uploaded media live (the compose volume).
DATA_DIR=./data

# Password for the web UI (single user).
ADMIN_PASSWORD=

# Signs approval links and sessions. Generate: openssl rand -hex 32
APP_SECRET=

# Timezone for slots and the calendar, e.g. Europe/London, Asia/Kolkata.
TZ=UTC

# Bearer token for POST /api/drafts (webhook source). Generate: openssl rand -hex 24
WEBHOOK_TOKEN=

# Platform keys are added in Settings and stored in the database.
# Optional: an LLM key for caption drafting.
# ANTHROPIC_API_KEY=

# Email approval (Settings: approval = email). Postwise mails the review address
# a caption and three slot links. SMTP_URL example: smtps://user:pass@smtp.example.com:465
# Leave both empty to use in-app approval only.
SMTP_URL=
MAIL_FROM=Postwise <postwise@example.com>
